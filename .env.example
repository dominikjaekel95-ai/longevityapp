# Alle Variablen der App. Echte Werte liegen nur in EAS Secrets (App) und Supabase Secrets (Edge Functions),
# nie im Repo. Lokal: Kopie als .env.local anlegen (ist in .gitignore).
#
# Variablen mit Präfix EXPO_PUBLIC_ werden in den App-Bundle eingebaut und sind damit öffentlich.
# Deshalb stehen hier nur Werte, die ohnehin öffentlich sein dürfen (Supabase-URL, Anon-Key).

# --- Supabase (Projekt in der Region EU, Frankfurt) ---
# Projekt-URL, z. B. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Anon-Key (öffentlich; der Zugriff wird durch Row Level Security begrenzt)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Foto-Schätzung ---
# "sichtbar" (Standard, Entscheidung Dominik 01.10.2026): Spanne ausklappbar im Check-in und im Verlauf. "hintergrund": nur protokolliert.
EXPO_PUBLIC_ESTIMATE_MODE=sichtbar

# --- Analytics: PostHog Cloud EU, nur mit Opt-in in den Einstellungen. Leer = aus (so im ersten Testbuild). ---
# Projekt-API-Key aus PostHog (öffentlich, Schreibrecht nur für Ereignisse)
EXPO_PUBLIC_POSTHOG_KEY=
# Host, Standard https://eu.i.posthog.com (EU-Cloud). Nie den US-Host.
EXPO_PUBLIC_POSTHOG_HOST=

# --- Links (Texte erstellt Dominik, nicht die Coding-Instanz) ---
EXPO_PUBLIC_URL_DATENSCHUTZ=https://nachderspritze.de/datenschutz/
EXPO_PUBLIC_URL_IMPRESSUM=https://nachderspritze.de/impressum/
EXPO_PUBLIC_URL_WISSEN=https://nachderspritze.de/wissen/

# --- Build (nur für app.config.ts und EAS, nicht im Bundle) ---
# Von `eas init` vergebene Projekt-ID und Expo-Kontoname
EAS_PROJECT_ID=
EXPO_OWNER=
# Arbeitstitel; der Android-Paketname ist nach dem ersten Play-Upload fest
APP_NAME=Longvy
ANDROID_PACKAGE=de.nachderspritze.longvy

# --- Nur Supabase Edge Functions (als Supabase Secrets setzen, nie in EAS) ---
# SUPABASE_SERVICE_ROLE_KEY wird von Supabase automatisch bereitgestellt.
# Google Cloud: Projekt, Region und Dienstkonto für Vertex AI (Gemini), Region bleibt in der EU.
# GCP_PROJECT_ID=
# GCP_LOCATION=europe-west3
# GCP_SERVICE_ACCOUNT_JSON=   (Inhalt der Schlüsseldatei des Dienstkontos, einzeilig)
# GEMINI_MODEL=gemini-2.5-flash
# ESTIMATE_PROVIDER=gemini   (gemini | claude | mock)
# Schwelle für den Konsistenz-Score zum Vorfoto (0 bis 1); darunter wird das Foto nicht gewertet
# ESTIMATE_CONSISTENCY_THRESHOLD=0.6
